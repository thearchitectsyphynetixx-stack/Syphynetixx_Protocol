{
  "SPDX License Identifier": {
    "prefix": "spdx",
    "body": ["// SPDX-License-Identifier: MIT"],
    "description": "Add SPDX license identifier"
  },
  "Pragma Statement": {
    "prefix": "pragma",
    "body": ["pragma solidity ^0.8.0;"],
    "description": "Solidity pragma statement"
  },
  "Contract Template": {
    "prefix": "contract",
    "body": [
      "// SPDX-License-Identifier: MIT",
      "pragma solidity ^0.8.0;",
      "",
      "contract ${1:ContractName} {",
      "    $0",
      "}"
    ],
    "description": "Basic contract template"
  },
  "Interface Template": {
    "prefix": "interface",
    "body": [
      "// SPDX-License-Identifier: MIT",
      "pragma solidity ^0.8.0;",
      "",
      "interface I${1:InterfaceName} {",
      "    $0",
      "}"
    ],
    "description": "Basic interface template"
  },
  "Constructor": {
    "prefix": "constructor",
    "body": ["constructor(${1:params}) {", "    $0", "}"],
    "description": "Contract constructor"
  },
  "Function": {
    "prefix": "function",
    "body": [
      "function ${1:functionName}(${2:params}) ${3:public} ${4:returns (${5:type})} {",
      "    $0",
      "}"
    ],
    "description": "Function definition"
  },
  "Modifier": {
    "prefix": "modifier",
    "body": ["modifier ${1:modifierName}(${2:params}) {", "    ${3:require(condition, \"error\");}", "    _;", "    $0", "}"],
    "description": "Custom modifier"
  },
  "Event": {
    "prefix": "event",
    "body": ["event ${1:EventName}(${2:params});"],
    "description": "Event declaration"
  },
  "Require Statement": {
    "prefix": "require",
    "body": ["require(${1:condition}, \"${2:error message}\");"],
    "description": "Require statement"
  },
  "Emit Event": {
    "prefix": "emit",
    "body": ["emit ${1:EventName}(${2:params});"],
    "description": "Emit an event"
  },
  "State Variable": {
    "prefix": "var",
    "body": ["${1:uint256} ${2:public} ${3:variableName};"],
    "description": "State variable declaration"
  },
  "Mapping": {
    "prefix": "mapping",
    "body": ["mapping(${1:address} => ${2:uint256}) ${3:public} ${4:mapName};"],
    "description": "Mapping declaration"
  },
  "Error Definition": {
    "prefix": "error",
    "body": ["error ${1:ErrorName}(${2:params});"],
    "description": "Custom error definition"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:StructName} {", "    ${2:uint256 field1};", "    $0", "}"],
    "description": "Struct definition"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:EnumName} {", "    ${2:Value1},", "    ${3:Value2}", "}"],
    "description": "Enum definition"
  }
}
